# =============================================================================
# 莲峰校园 Lfc 后端环境变量模板
# 开发环境：复制本文件为 .env.development 并填写真实值（日常开发改 .env.development）
# 生产环境：复制为 .env.production
# 启动命令：NODE_ENV=development npm run start:dev
# 配置加载：src/app.module.ts 读取 .env.${NODE_ENV}
# =============================================================================

# 运行环境：development | production | test
NODE_ENV=development

# HTTP 服务监听地址（0.0.0.0 表示允许局域网访问）
HOST=0.0.0.0

# HTTP 服务端口
PORT=3000

# -----------------------------------------------------------------------------
# MySQL 数据库
# -----------------------------------------------------------------------------

# 数据库主机
MYSQL_HOST=127.0.0.1

# 数据库端口
MYSQL_PORT=3306

# 数据库用户名
MYSQL_USERNAME=root

# 数据库密码
MYSQL_PASSWORD=

# 数据库名
MYSQL_DATABASE=lfc

# 是否自动同步表结构（生产环境建议 false，改用手动执行 scripts/ 下 SQL）
MYSQL_SYNCHRONIZE=true

# -----------------------------------------------------------------------------
# Redis 缓存 / 会话
# -----------------------------------------------------------------------------

# 连接协议，一般为 redis
REDIS_PROTOCOL=redis

# Redis 主机
REDIS_HOST=127.0.0.1

# Redis 端口
REDIS_PORT=6379

# Redis 密码（无密码留空）
REDIS_PASSWORD=

# Redis 数据库编号
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT 鉴权
# -----------------------------------------------------------------------------

# JWT 签名密钥（生产环境务必使用强随机字符串）
JWT_SECRET=change-me-in-production

# Access Token 有效期，如 2d、12h
JWT_ACCESS_EXPIRES_IN=2d

# Refresh Token 有效期
JWT_REFRESH_EXPIRES_IN=10d

# -----------------------------------------------------------------------------
# 管理员种子账号（首次启动时创建，可选）
# -----------------------------------------------------------------------------

# 管理员登录邮箱
ADMIN_EMAIL=admin@example.com

# 管理员登录密码
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 阿里云账号（OSS 图片上传等）
# -----------------------------------------------------------------------------

# 阿里云 AccessKey ID
ALIYUN_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret
ALIYUN_ACCESS_KEY_SECRET=

# OSS 所在 Region，如 oss-cn-shanghai
ALIYUN_OSS_REGION=oss-cn-shanghai

# OSS Endpoint，如 https://oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_ENDPOINT=

# 公开读 Bucket（头像等可公开资源）
ALIYUN_OSS_BUCKET_PUBLIC=

# 私有 Bucket（需签名访问的资源）
ALIYUN_OSS_BUCKET_PRIVATE=

# 处理中/中转 Bucket
ALIYUN_OSS_BUCKET_PROCESSING=

# STS 临时上传角色 ARN（客户端直传时使用，可选）
ALIYUN_OSS_ROLE_ARN=

# -----------------------------------------------------------------------------
# 阿里云邮件（DirectMail，可选，当前部分功能预留）
# -----------------------------------------------------------------------------

# 邮件 API Endpoint
ALIYUN_MAIL_ENDPOINT=https://dm.aliyuncs.com

# 发信地址（需在阿里云邮件控制台验证）
ALIYUN_MAIL_ACCOUNT_NAME=

# 是否使用回信地址
ALIYUN_MAIL_REPLY_TO_ADDRESS=true

# 默认收信地址（测试/通知用）
ALIYUN_MAIL_TO_ADDRESS=

# -----------------------------------------------------------------------------
# 支付宝（App 支付 + 商家分账）
# 需在支付宝开放平台开通：App 支付、商家分账
# -----------------------------------------------------------------------------

# 开放平台应用 AppID
ALIPAY_APP_ID=

# 应用私钥（RSA2，可单行并用 \n 表示换行）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（非应用公钥）
ALIPAY_ALIPAY_PUBLIC_KEY=

# 网关地址
# 沙箱：https://openapi.alipaydev.com/gateway.do
# 正式：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付异步通知地址（须公网 HTTPS 可访问）
# 对应接口：POST /alipay/notify
ALIPAY_NOTIFY_URL=

# 商户 PID（开放平台账户中心查看，App 支付宝授权登录必填）
ALIPAY_PID=

# -----------------------------------------------------------------------------
# C2C 支付 / 平台抽成
# -----------------------------------------------------------------------------

# 平台服务费率，0.05 表示 5%
PAYMENT_PLATFORM_FEE_RATE=0.05

# 单笔最低平台服务费（元），0 表示不限制
PAYMENT_PLATFORM_FEE_MIN=0

# 闲置交易自动确认收货天数，超时后自动分账给卖家
PAYMENT_AUTO_CONFIRM_DAYS=7

# -----------------------------------------------------------------------------
# 增值服务（擦亮 / 活动推广）
# 付费模式：App 支付 → 全额进入商户支付宝账户（不开启分账，不调用分账 API）
# 与闲置/活动报名的 C2C 分账链路相互独立
# 开发环境请写入 .env.development
# -----------------------------------------------------------------------------

# 笔记擦亮有效时长（小时）
PROMOTION_POST_BOOST_HOURS=48

# 笔记擦亮冷却（小时）
PROMOTION_POST_COOLDOWN_HOURS=48

# 发现页同时擦亮位数量上限
PROMOTION_POST_MAX_FEED_SLOTS=2

# 是否启用付费擦亮/推广（false=免费，true=支付宝直付平台）
PROMOTION_PAID_ENABLED=false

# 笔记擦亮单价（元）
PROMOTION_POST_BOOST_PRICE=2.00

# 活动推广单价（元）
PROMOTION_ACTIVITY_PROMOTE_PRICE=3.00

# 推广位已满时抢位最低加价（元）
PROMOTION_BID_INCREMENT=0.50

# 订单 payeeId 仅用于账务字段，增值服不会向该用户做分账
PROMOTION_PLATFORM_PAYEE_ID=1

# 活动推广有效时长（小时）
PROMOTION_ACTIVITY_PROMOTE_HOURS=72

# 活动推广冷却（小时）
PROMOTION_ACTIVITY_COOLDOWN_HOURS=168

# 活动 Tab 同时推广位数量上限
PROMOTION_ACTIVITY_MAX_FEED_SLOTS=2

# -----------------------------------------------------------------------------
# 微信支付（当前未启用，预留）
# -----------------------------------------------------------------------------

# 微信 AppID
WECHAT_PAY_APP_ID=

# 微信商户号
WECHAT_PAY_MCH_ID=

# API v3 密钥
WECHAT_PAY_API_V3_KEY=

# 商户 API 私钥
WECHAT_PAY_PRIVATE_KEY=

# 商户证书序列号
WECHAT_PAY_SERIAL_NO=

# 支付回调地址
WECHAT_PAY_NOTIFY_URL=

# -----------------------------------------------------------------------------
# 高德地图
# Android 客户端：client/consumer/android/lfc/gradle.properties → AMAP_API_KEY
# Web 服务 Key：后端逆地理编码、POI 搜索等
# -----------------------------------------------------------------------------

# 高德 Web 服务 Key（服务端逆地理、POI 搜索等，须在高德控制台单独创建「Web 服务」类型 Key）
# 与 Android 定位 Key（gradle.properties → AMAP_API_KEY）不同，不能混用
AMAP_WEB_SERVICE_KEY=

# 高德 Android 平台 Key（文档对照，实际配置在 Android gradle.properties）
AMAP_ANDROID_KEY=
